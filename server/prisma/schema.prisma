generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================================
// IDENTITY & ACCESS
// ===================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  phone        String?
  // Password reset
  resetToken   String?
  resetExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships      Membership[]
  createdOrgs      Organization[] @relation("OrgCreator")
  auditLogs        AuditLog[]
  customerProfiles Customer[]     @relation("CustomerUser")

  @@map("users")
}

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  gstin       String? // GST Identification Number
  address     String?
  city        String?
  state       String?
  pincode     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  creator            User                 @relation("OrgCreator", fields: [createdById], references: [id])
  memberships        Membership[]
  auditLogs          AuditLog[]
  products           Product[]
  plans              Plan[]
  customers          Customer[]
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  payments           Payment[]
  discounts          Discount[]
  taxes              Tax[]
  settings           OrganizationSetting?
  notifications      Notification[]
  billingRuns        BillingRun[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(CUSTOMER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  resource       String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

enum MembershipRole {
  ADMIN // Full access (was OWNER)
  STAFF // Operational access (was ADMIN)
  CUSTOMER // Customer-facing read/self-service (was MEMBER)
}

// ===================================================================
// PRODUCT CATALOGUE
// ===================================================================

model Product {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  productType    String
  salesPrice     Decimal   @db.Decimal(12, 2)
  costPrice      Decimal   @db.Decimal(12, 2)
  description    String?
  category       String?
  isActive       Boolean   @default(true)
  availableFrom  DateTime?
  availableUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]
  plans        Plan[]
  discounts    Discount[]

  @@index([organizationId])
  @@map("products")
}

// A customer is an organization-owned billing contact.  It may optionally be
// linked to an authenticated User for the customer portal, but is not a
// membership by itself.
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  email          String
  phone          String?
  companyName    String?
  gstin          String?
  billingAddress String?
  city           String?
  state          String?
  pincode        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?                @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)
  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
  redemptions   DiscountRedemption[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([userId])
  @@map("customers")
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  name               String // e.g. "Annual 10-seat", "Monthly Basic"
  sku                String?
  basePrice          Decimal  @db.Decimal(12, 2)
  priceAdjustment    Decimal  @default(0) @db.Decimal(12, 2) // fixed adjustment, e.g. Odoo brand +₹560
  priceAdjustmentPct Decimal? @db.Decimal(5, 2) // % adjustment from product base
  minQuantity        Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines QuotationLine[]

  @@index([productId])
  @@map("product_variants")
}

// ===================================================================
// PLANS & BILLING
// ===================================================================

model Plan {
  id               String           @id @default(cuid())
  organizationId   String
  productId        String
  name             String // e.g. "Starter Monthly", "Pro Annual"
  description      String?
  billingFrequency BillingFrequency
  basePrice        Decimal          @db.Decimal(12, 2)
  setupFee         Decimal?         @db.Decimal(12, 2)
  trialDays        Int              @default(0)
  minQuantity      Int              @default(1)
  isActive         Boolean          @default(true)
  availableFrom    DateTime?
  availableUntil   DateTime?
  status           PlanStatus       @default(DRAFT)
  autoCloseAtEnd   Boolean          @default(true)
  allowEarlyClose  Boolean          @default(true)
  allowPause       Boolean          @default(true)
  allowRenewal     Boolean          @default(true)
  paymentTermsDays Int              @default(30)
  features         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([organizationId])
  @@index([productId])
  @@map("plans")
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ===================================================================
// QUOTATIONS
// ===================================================================

model Quotation {
  id             String          @id @default(cuid())
  organizationId String
  number         String // e.g. Q/2026/0001
  customerId     String?
  customerName   String?
  customerEmail  String?
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  notes          String?
  subtotal       Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines        QuotationLine[]
  subscription Subscription?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@map("quotations")
}

model QuotationTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  validForDays   Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        QuotationTemplateLine[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id                  String  @id @default(cuid())
  quotationTemplateId String
  productVariantId    String?
  description         String
  quantity            Int     @default(1)
  unitPrice           Decimal @db.Decimal(12, 2)
  discountPct         Decimal @default(0) @db.Decimal(5, 2)
  taxRate             Decimal @default(18) @db.Decimal(5, 2)
  sortOrder           Int     @default(0)

  quotationTemplate QuotationTemplate @relation(fields: [quotationTemplateId], references: [id], onDelete: Cascade)

  @@index([quotationTemplateId])
  @@map("quotation_template_lines")
}

model QuotationLine {
  id               String  @id @default(cuid())
  quotationId      String
  productVariantId String?
  description      String
  quantity         Int     @default(1)
  unitPrice        Decimal @db.Decimal(12, 2)
  discountPct      Decimal @default(0) @db.Decimal(5, 2)
  taxRate          Decimal @default(18) @db.Decimal(5, 2) // GST 18%
  subtotal         Decimal @db.Decimal(12, 2)
  taxAmount        Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)
  sortOrder        Int     @default(0)

  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_lines")
}

enum QuotationStatus {
  DRAFT
  SENT
  CONFIRMED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

// ===================================================================
// SUBSCRIPTIONS
// ===================================================================

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String
  planId           String
  quotationId      String?            @unique
  customerId       String?
  number           String // e.g. SUB/2026/0001
  customerName     String
  customerEmail    String
  status           SubscriptionStatus @default(DRAFT)
  startDate        DateTime
  endDate          DateTime?
  nextBillingDate  DateTime?
  quantity         Int                @default(1)
  unitPrice        Decimal            @db.Decimal(12, 2)
  discountId       String?
  discountAmount   Decimal            @default(0) @db.Decimal(12, 2)
  taxRate          Decimal            @default(18) @db.Decimal(5, 2)
  paymentTermsDays Int                @default(30)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotation    Quotation?            @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount     Discount?             @relation(fields: [discountId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  history      SubscriptionHistory[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([planId])
  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  IN_PROGRESS
  PAUSED
  CLOSED
  EXPIRED
}

model SubscriptionHistory {
  id             String              @id @default(cuid())
  subscriptionId String
  organizationId String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  changedById    String?
  createdAt      DateTime            @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_history")
}

// ===================================================================
// INVOICES
// ===================================================================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  customerId     String?
  number         String // e.g. INV/2026/0001
  customerName   String
  customerEmail  String
  gstin          String?
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  amountDue      Decimal       @db.Decimal(12, 2)
  notes          String?
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  redemptions  DiscountRedemption[]

  @@unique([organizationId, number])
  @@unique([subscriptionId, periodStart])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(18) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  POSTED
  PAID // Fully paid
  PARTIAL // Partially paid
  OVERDUE // Past due date
  CANCELLED
}

// ===================================================================
// PAYMENTS
// ===================================================================

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  invoiceId         String
  number            String // e.g. PAY/2026/0001
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod @default(BANK_TRANSFER)
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?
  reference         String? // UTR / Cheque no / Transaction ID
  failureReason     String?
  refundedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paidAt            DateTime      @default(now())
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  CARD
  NEFT
  RTGS
  IMPS
}

// ===================================================================
// DISCOUNTS
// ===================================================================

model Discount {
  id                 String       @id @default(cuid())
  organizationId     String
  name               String
  code               String
  type               DiscountType
  value              Decimal      @db.Decimal(10, 2) // amount or %
  minAmount          Decimal?     @db.Decimal(12, 2)
  minQuantity        Int?
  productId          String?
  maxUses            Int?
  maxUsesPerCustomer Int?
  usedCount          Int          @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  redemptions   DiscountRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([productId])
  @@map("discounts")
}

model DiscountRedemption {
  id             String   @id @default(cuid())
  discountId     String
  organizationId String
  customerId     String?
  invoiceId      String?
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  discount Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([discountId, customerId])
  @@index([organizationId, createdAt])
  @@map("discount_redemptions")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ===================================================================
// TAXES
// ===================================================================

model Tax {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. "GST 18%", "IGST 18%"
  rate           Decimal  @db.Decimal(5, 2)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("taxes")
}

model OrganizationSetting {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  currency                String   @default("INR")
  timezone                String   @default("Asia/Kolkata")
  invoicePrefix           String   @default("INV")
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  title          String
  body           String
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model BillingRun {
  id                     String    @id @default(cuid())
  organizationId         String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  status                 String    @default("RUNNING")
  subscriptionsProcessed Int       @default(0)
  invoicesCreated        Int       @default(0)
  failures               Json?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@map("billing_runs")
}
